{
    "name": "Apple Music",
    "description": "Play Apple Music tracks and add them to your library",
    "id": "magritte.applemusic",
    "version": "0.0.0",
    "url": "/",
    "icon_url": "/icon.svg",
    "preferredWidth": "16rem",
    "preferredHeight": "16rem",
    "permissions": [
        "run:background",
        "run:eager",
        "libraries:read",
        "libraries:write",
        "playback:read",
        "playback:control"
    ],
    "sourceSchemes": ["applemusic"],
    "commands": [
        {
            "id": "account.authorize",
            "searchTerms": "authorize deauthorize",
            "requiredInputKinds": []
        }
    ]
}
