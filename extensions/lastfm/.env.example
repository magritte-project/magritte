# The API key for the Last.fm API account this extension authenticates with.
# Create one at <https://www.last.fm/api/account/create>.
VITE_LASTFM_API_KEY=""

# The shared secret for the same Last.fm API account.
#
# Note: like every other `VITE_` value, this is bundled into the extension and
# is therefore readable by anyone who can load it. Last.fm has no public client
# flow, so use an API account dedicated to your instance.
VITE_LASTFM_API_SECRET=""
