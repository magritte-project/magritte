      "object_id" : "01247F7C-9593-49A0-8450-B017FEF94E9D",
      "text" : "find(address)\n  let current = this\n  for name in address\n    next = current.subs[name]\n    if next = null\n      raise BadAddress\n  return current\n-----------------------------------------------\nroot.find([])     -> root\nroot.find([A, B]) -> root.subs[A].subs[b]",
      "type_id" : 27
    },
