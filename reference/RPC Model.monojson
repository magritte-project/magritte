    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "9D1BD585-812E-4780-B898-4B90B9E5D657",
      "rect_position" : 16,
      "type_id" : 12
    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "9E31FF07-81CB-4686-9865-20E5F0CD920D",
      "rect_position" : 16,
      "type_id" : 12
    },
    {
      "alignment" : 0,
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "9F879480-043C-4717-9205-14780CCD15AA",
      "text" : "- Every object implements these 3 primitive operations\n- Remote objects forward these operations over a transport to objects local to a different location\n- A transport may be any bidirectional pipe including JS MessagePipes or async JSON messages passed between a web page and its host browser app",
      "type_id" : 27
    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "9FDD252F-D7E4-4A89-8780-BE877AAA255B",
      "type_id" : 18
    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "A02BFF82-767C-4D5E-AC76-70773CD97B91",
      "rect_position" : 12,
      "type_id" : 12
    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "A0CB76E2-DAA3-4A09-BC83-F25314EA07DE",
      "type_id" : 18
    },
    {
      "alignment" : 0,
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "A4EC0A12-84FF-4326-9722-C318EA4E1E9C",
      "text" : "invoke(selector, parameters)\n  method = this.methods[selector]\n  if method = null\n    raise InvalidSelector\n  validParameters = method.validate(parameters)\n  return method(validParameters)",
      "type_id" : 27
    },
    {
      "doc_ref" : "D9087392-A0DF-4114-82D4-AAF1AC711DDC",
      "object_id" : "A5522A73-7F2B-4C71-8104-A2082FB875B7",
      "text" : "A",
      "type_id" : 27
    },
