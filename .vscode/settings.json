{
    "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "always",
        "source.fixAll.ruff": "always"
    },
    "oxc.enable": true,
    "editor.formatOnSave": true,
    "files.watcherExclude": {
        "**/routeTree.gen.ts": true
    },
    "files.readonlyInclude": {
        "**/routeTree.gen.ts": true
    },
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "search.exclude": {
        "**/routeTree.gen.ts": true
    },
    "python.defaultInterpreterPath": "server/.venv/bin/python",
    "python.envFile": "${workspaceFolder}/server/.env",
    "python.testing.cwd": "${workspaceFolder}/server/",
    "python.analysis.extraPaths": ["${workspaceFolder}/server/"],
    "ty.interpreter": ["${workspaceFolder}/server/.venv/bin/python"],
    "ty.inlayHints.callArgumentNames": false,
    "ty.inlayHints.variableTypes": false,
    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    }
}
