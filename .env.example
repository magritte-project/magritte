## -- server --  ##

# The environment the server is running in
ENV=dev

# The secret used when signing user session access tokens
#
# In a typical development environment, this will be generated for
# you the first time you run the API server. Otherwise, you can use
# the admin tool to generate a value for this for you:
#   ./admin new-token-secret
# Paste the result in your .env file below
SESSION_TOKEN_SECRET=

# The secret used when signing file access tokens
#
# In a typical development environment, this will be generated for
# you the first time you run the API server. Otherwise, you can use
# the admin tool to generate a value for this for you:
#   ./admin new-token-secret
# Paste the result in your .env file below
FILE_TOKEN_SECRET=

# The salt added to passwords before storing them in the DB
# In a typical development environment, this will be generated for
# you the first time you run the API server. Otherwise, you can use
# the admin tool to generate a value for this for you:
#   ./admin new-password-salt
# Paste the result in your .env file below
SALT=

# The URL to connect to the database
#
# You generally want this to be a path to an sqlite3 file.
# The default is to place the db file in the project directory.
DB=sqlite+aiosqlite:///./db.sqlite3

# Where images are stored and retrieved from
#
# You want this to be an absolute path to a directory.
# The default is to place artworks in a project subdirectory.
IMAGE_HOME=./db.artwork

# Where library files are stored and retrieved from
#
# This should an absolute file URL to your music directory.
# E.g. On macOS: file:///Users/me/Music/Library
LIBRARY_HOME=file://

# Whether the server should watch the library for changes
WATCH_LIBRARY=true

## -- server.services.applemusic -- ##

# The ID of the team the Apple Music key was generated under.
# Leave this empty if you don't want to use Apple Music features.
APPLE_MUSIC_TEAM_ID=

 # The ID of the app the Apple Music key is associated with.
# Leave this empty if you don't want to use Apple Music features.
APPLE_MUSIC_APP_ID=

# The ID of the key on the Apple developer portal.
# Leave this empty if you don't want to use Apple Music features.
APPLE_MUSIC_KEY_ID=

# The contents of the key used to authenticate with Apple Music.
# Leave this empty if you don't want to use Apple Music features.
APPLE_MUSIC_KEY_SECRET=

# The storefront that your Apple Music account is registered under.
APPLE_MUSIC_STOREFRONT=us

## -- web --  ##

# The environment the web app is running in
VITE_ENV=dev

# The URL the server API can be accessed at from the web app.
# You generally won't need to edit this unless you're running
# an instance in an unusual configuration.
VITE_API_URL=/api
