## -- server --  ##

# The secret used when signing user session access tokens
#
# You can use the admin tool to generate a value for this for you:
#   ./admin new-token-secret
# Paste the result in your .env file below
SESSION_TOKEN_SECRET=

# The secret used when signing file access tokens
#
# You can use the admin tool to generate a value for this for you:
#   ./admin new-token-secret
# Paste the result in your .env file below
FILE_TOKEN_SECRET=

# The salt added to passwords before storing them in the DB
#
# You can use the admin tool to generate a value for this for you:
#   ./admin new-password-salt
# Paste the result in your .env file below
PASSWORD_SALT=

# The URL to connect to the database
#
# You generally want this to be an absolute path to an sqlite3 file.
# E.g. On macOS: sqlite+aiosqlite:////Users/me/Projects/magritte/_testing.sqlite
DB=sqlite+aiosqlite://

# Where images are stored and retrieved from
#
# You want this to be an absolute path to a directory.
# E.g. On macOS: /Users/me/Projects/magritte/_covers
IMAGE_HOME=/tmp

# Where library files are stored and retrieved from
#
# This should be the absolute path to your music directory.
# E.g. On macOS: /Users/me/Music/Library
LIBRARY_HOME=

# Whether the server should rescan the library when starting up
RESCAN_LIBRARY_ON_START=true

# Whether the server should watch the library for changes
WATCH_LIBRARY=true

## -- server.plugins -- ##

APPLE_MUSIC_APP_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_KEY_SECRET=

## -- web --  ##

# The URL the server API can be accessed at from the web app
VITE_API_URL=/api
