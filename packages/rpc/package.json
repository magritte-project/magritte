{
    "name": "@magritte/rpc",
    "version": "0.1.0",
    "description": "RPC infrastructure for cross-origin communication in Magritte clients",
    "keywords": [
        "communication",
        "cross-origin",
        "magritte",
        "rpc"
    ],
    "homepage": "https://github.com/magritte-project/magritte/tree/main/packages/rpc#readme",
    "bugs": {
        "url": "https://github.com/magritte-project/magritte/issues"
    },
    "license": "MIT",
    "author": {
        "name": "P. Kevin Contreras",
        "email": "magritte@swampmonkeyco.com",
        "url": "https://magritte-project.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magritte-project/magritte.git",
        "directory": "packages/rpc"
    },
    "funding": {
        "type": "individual",
        "url": "https://github.com/sponsors/decarbonization"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./transports": {
            "types": "./src/transports/index.ts",
            "default": "./src/transports/index.ts"
        }
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./transports": {
                "types": "./dist/transports.d.ts",
                "default": "./dist/transports.js"
            }
        },
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "format": "oxfmt",
        "lint": "oxlint",
        "check": "oxlint && oxfmt --check"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "catalog:",
        "@typescript/typescript6": "6.0.2",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "zod": "^4.6.7"
    },
    "packageManager": "pnpm@12.8.1"
}
