{
    "openapi": "3.1.0",
    "info": {
        "title": "Magritte Extension SDK",
        "version": "1.0.0"
    },
    "components": {
        "schemas": {
            "ExtensionPermissions": {
                "type": "string",
                "enum": [
                    "run:background",
                    "run:eager",
                    "commands:input:read",
                    "commands:input:add",
                    "commands:query",
                    "commands:run",
                    "libraries:read",
                    "libraries:write",
                    "playback:read",
                    "playback:control"
                ]
            },
            "ExtensionCommand": {
                "type": "object",
                "required": ["id", "searchTerms", "requiredInputKinds"],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the command"
                    },
                    "searchTerms": {
                        "type": "string",
                        "description": "The static search terms for the command"
                    },
                    "requiredInputKinds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "description": "The kinds of the inputs this command requires to execute"
                    }
                }
            },
            "ExtensionManifest": {
                "type": "object",
                "required": ["name", "id", "version", "url"],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "A friendly name for the extension"
                    },
                    "id": {
                        "type": "string",
                        "description": "A unique identifier for the extension"
                    },
                    "version": {
                        "type": "string",
                        "description": "The version of the extension"
                    },
                    "description": {
                        "type": "string",
                        "description": "An optional description of the extension"
                    },
                    "url": {
                        "type": "string",
                        "description": "The URL of the extension"
                    },
                    "preferredWidth": {
                        "type": "string",
                        "description": "The preferred width of the extension as a CSS dimension"
                    },
                    "preferredHeight": {
                        "type": "string",
                        "description": "The preferred height of the extension as a CSS dimension"
                    },
                    "permissions": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ExtensionPermissions" },
                        "default": [],
                        "description": "An optional array of permissions required by the extension"
                    },
                    "sourceSchemes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "description": "An optional array of source schemes supported by the extension"
                    },
                    "commands": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ExtensionCommand" },
                        "default": [],
                        "description": "An optional array of commands supported by the extension"
                    }
                }
            }
        }
    }
}
