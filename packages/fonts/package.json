{
    "name": "@magritte/fonts",
    "version": "0.1.1",
    "description": "Fonts shared by the Magritte front end and extensions",
    "keywords": [
        "extensions",
        "fonts",
        "magritte"
    ],
    "homepage": "https://github.com/magritte-project/magritte/tree/main/packages/fonts#readme",
    "bugs": {
        "url": "https://github.com/magritte-project/magritte/issues"
    },
    "license": "(OFL-1.1 AND Bitstream-Vera)",
    "author": {
        "name": "P. Kevin Contreras",
        "email": "magritte@swampmonkeyco.com",
        "url": "https://magritte-project.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magritte-project/magritte.git",
        "directory": "packages/fonts"
    },
    "funding": {
        "type": "individual",
        "url": "https://github.com/sponsors/decarbonization"
    },
    "files": [
        "index.css",
        "index.d.ts",
        "BitstreamVeraSans",
        "BitstreamVeraSansMono",
        "BitstreamVeraSerif",
        "Comfortaa",
        "FiraGO",
        "FiraMono",
        "IBMPlexSans",
        "Inter",
        "*.txt",
        "*.TXT"
    ],
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.css"
        },
        "./bitstream-vera-sans.css": "./BitstreamVeraSans/BitstreamVeraSans.css",
        "./bitstream-vera-sans-mono.css": "./BitstreamVeraSansMono/BitstreamVeraSansMono.css",
        "./bitstream-vera-serif.css": "./BitstreamVeraSerif/BitstreamVeraSerif.css",
        "./comfortaa.css": "./Comfortaa/Comfortaa.css",
        "./fira-go.css": "./FiraGO/FiraGO.css",
        "./fira-mono.css": "./FiraMono/FiraMono.css",
        "./ibm-plex-sans.css": "./IBMPlexSans/IBMPlexSans.css",
        "./inter.css": "./Inter/Inter.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@12.8.1"
}
