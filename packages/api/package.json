{
    "name": "@magritte/api",
    "version": "0.1.0",
    "description": "API client and schemas for interacting with Magritte instances",
    "keywords": [
        "api",
        "client",
        "magritte",
        "schemas"
    ],
    "homepage": "https://github.com/magritte-project/magritte/tree/main/packages/api#readme",
    "bugs": {
        "url": "https://github.com/magritte-project/magritte/issues"
    },
    "license": "MIT",
    "author": {
        "name": "P. Kevin Contreras",
        "email": "magritte@swampmonkeyco.com",
        "url": "https://magritte-project.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magritte-project/magritte.git",
        "directory": "packages/api"
    },
    "funding": {
        "type": "individual",
        "url": "https://github.com/sponsors/decarbonization"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "access": "public"
    },
    "scripts": {
        "build": "vite build",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "format": "oxfmt",
        "lint": "oxlint",
        "check": "oxlint && oxfmt --check",
        "generate-openapi": "openapi-ts"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
        "@microsoft/api-extractor": "catalog:",
        "@typescript/typescript6": "6.0.2",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plugin-dts": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "zod": "^4.6.7"
    },
    "packageManager": "pnpm@12.8.1"
}
