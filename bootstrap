#!/bin/sh

if ! command -v asdf >/dev/null 2>&1; then
    echo "Error: asdf not installed. Install <https://asdf-vm.com/> to continue." >&2
    exit 1
fi

set -e

# Add all required asdf plugins
asdf plugin add just
asdf plugin add nodejs
asdf plugin add pnpm
asdf plugin add uv

# Ensure all asdf plugins are up to date
asdf plugin update just
asdf plugin update nodejs
asdf plugin update pnpm
asdf plugin update uv

# Install project tooling
asdf install

# Set up the environment files
[ ! -e .env ] && cp "$PWD/.env.example" "$PWD/.env"
[ ! -e web/.env ] && ln -s "$PWD/.env" "$PWD/web/.env"
for example in "$PWD"/extensions/*/.env.example; do
    [ -e "$example" ] || continue
    env_file="$(dirname "$example")/.env"
    if [ ! -e "$env_file" ]; then
        cp "$example" "$env_file"
    fi
done

# Set up dependencies
just sync-deps
